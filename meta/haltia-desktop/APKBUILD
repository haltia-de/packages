# The Haltia desktop: the shell, its library and the programs every user
# gets (ADR 0004): the haltia- packages (the b8k- names before 2.0.0).
pkgname=haltia-desktop
pkgver=2.0.0
pkgrel=0
pkgdesc="Haltia, a calm touch desktop: shell and programs"
url="https://github.com/haltia-de/packages"
arch="noarch"
license="GPL-2.0-only"
depends="
	haltia-keys
	haltia-shell
	py3-haltia-kit
	haltia-files
	haltia-text
	haltia-calendar
	haltia-video
	haltia-news
	haltia-paint
	haltia-firefox
	"
options="!check"

package() {
	mkdir -p "$pkgdir"
}
